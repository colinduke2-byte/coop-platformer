{
  "name": "frostfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frostfall - a top-down 8-bit Nordic action RPG (Phaser 3 + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/run.mjs",
    "test:fast": "node test/run.mjs --fast",
    "test:long": "node test/run.mjs --long",
    "test:unit": "node test/unit/unit.mjs",
    "balance": "node test/balance.mjs",
    "monkey": "node test/monkey.mjs 40",
    "build:single": "vite build && node tools/single-file.mjs frostfall.html",
    "lint": "eslint ."
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright": "^1.56.1",
    "vite": "^8.3.2"
  }
}
